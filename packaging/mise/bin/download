#!/usr/bin/env bash
set -euo pipefail

VERSION="${ASDF_INSTALL_VERSION:-$1}"
DOWNLOAD_PATH="${ASDF_DOWNLOAD_PATH:-$2}"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$ARCH" in
  x86_64|amd64) ARCH="amd64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

case "$OS" in
  linux) PLATFORM="linux" ;;
  darwin) PLATFORM="darwin" ;;
  *) echo "Unsupported operating system: $OS" >&2; exit 1 ;;
esac

TAG="v${VERSION#v}"
URL="https://github.com/peekstore/tasklynx/releases/download/${TAG}/tasklynx-${PLATFORM}-${ARCH}"

mkdir -p "$DOWNLOAD_PATH"
curl -fsSL -o "${DOWNLOAD_PATH}/tasklynx" "$URL"
chmod +x "${DOWNLOAD_PATH}/tasklynx"
