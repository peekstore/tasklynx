#!/usr/bin/env bash
set -euo pipefail

DOWNLOAD_PATH="${ASDF_DOWNLOAD_PATH:-$2}"
INSTALL_PATH="${ASDF_INSTALL_PATH:-$3}"

mkdir -p "${INSTALL_PATH}/bin"
cp "${DOWNLOAD_PATH}/tasklynx" "${INSTALL_PATH}/bin/tasklynx"
chmod +x "${INSTALL_PATH}/bin/tasklynx"
ln -sf "${INSTALL_PATH}/bin/tasklynx" "${INSTALL_PATH}/bin/tx"
